# 個人の設定。配布するのは config/office.example.json のほうで、
# 初回起動時にそこから office.json が作られる。
config/office.json

# フックの登録。インタプリタの名前もリポジトリの置き場所も環境ごとに違うので、
# サーバー起動時に実際の絶対パスで書き出している。
.claude/settings.local.json

# 実行時に生成される個人のセッション情報（会話の記憶）と、各キャラの状態
state/sessions/
state/agents.json

# 排他制御のためだけに作られるロックファイル
state/agents.json.lock
config/office.json.lock

# 状態ファイルの書き込み中に作られる一時ファイル。
# 通常は os.replace で消えるが、書き込み中にプロセスが落ちると residue が残る。
state/agents.json.*.tmp

# 実際の利用で生成された成果物（テンプレートには含めない）
lp/

# OS / エディタ
.DS_Store
__pycache__/
*.pyc
